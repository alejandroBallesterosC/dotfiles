{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "infrastructure-as-code@personal-configs": true,
    "playwright@personal-configs": true,
    "notify@personal-configs": true,
    "precise-technical-communication@personal-configs": true,
    "core-workflow@personal-configs": true,
    "clear-writing@personal-configs": true
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "ghostty"
}
